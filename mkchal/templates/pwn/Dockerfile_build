FROM base_image

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libc6-dev make && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build/
RUN ./build.sh && chmod 555 chall

CMD ["/bin/sh", "-c", "cp /build/chall /out/.chall.tmp && mv /out/.chall.tmp /out/chall"]
